pkgver=2606.r292.gcd3ea81
pkgrel=1
pkgdesc='A Nintendo Wii and GameCube emulator'
arch=(x86_64)
url=https://github.com/dolphin-emu/dolphin
license=(GPL-2.0-or-later)
depends=(
