pkgver() {
  cd $_pkgname

  git describe --long --tags --abbrev=7 | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd $_pkgname

  patch -p1 < ../optional-systemd.patch

  submodules=(Externals/{cubeb/cubeb,mGBA/mgba,cpp-ipc/cpp-ipc,cpp-optparse/cpp-optparse,imgui/imgui,implot/implot,tinygltf/tinygltf,rcheevos/rcheevos,watcher/watcher,VulkanMemoryAllocator})
  for submodule in ${submodules[@]}; do
    git submodule set-url ${submodule} "${srcdir}/${submodule##*/}"
    git -c protocol.file.allow=always submodule update --init ${submodule}
  done
  cd Externals/cubeb/cubeb
  git submodule set-url cmake/sanitizers-cmake "${srcdir}/sanitizers-cmake"
  git -c protocol.file.allow=always submodule update --init cmake/sanitizers-cmake
}

build() {
  CC=clang
  CXX=clang++
  LDFLAGS="${LDFLAGS} -fuse-ld=lld"

  export CC CXX LDFLAGS

  cmake_default_flags=(
    -DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON
    -DCMAKE_SKIP_RPATH=ON
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_C_COMPILER="${CC}"
    -DCMAKE_CXX_COMPILER="${CXX}"
    -DCMAKE_C_FLAGS="${CFLAGS}"
    -DCMAKE_CXX_FLAGS="${CXXFLAGS}"
    -DCMAKE_EXE_LINKER_FLAGS="${LDFLAGS}"
    -DCMAKE_MODULE_LINKER_FLAGS="${LDFLAGS}"
    -DCMAKE_SHARED_LINKER_FLAGS="${LDFLAGS}"
  )

  cmake -S $_pkgname -B build -G Ninja \
    "${cmake_default_flags[@]}" \
    -DOpenGL_GL_PREFERENCE=GLVND \
    -DUSE_SYSTEM_LIBS=ON \
    -DUSE_UPNP=ON \
    -DUSE_MGBA=ON \
    -DUSE_DISCORD_PRESENCE=ON \
    -DUSE_RETRO_ACHIEVEMENTS=ON \
    -DENCODE_FRAMEDUMPS=ON \
    -DENABLE_X11=ON \
    -DENABLE_EGL=ON \
    -DENABLE_CLI_TOOL=ON \
    -DENABLE_QT=ON \
    -DENABLE_LTO=ON \
    -DENABLE_ALSA=ON \
    -DENABLE_PULSEAUDIO=ON \
    -DENABLE_CUBEB=ON \
    -DENABLE_LLVM=ON \
    -DENABLE_VULKAN=ON \
    -DENABLE_SDL=ON \
    -DENABLE_HWDB=ON \
    -DENABLE_EVDEV=ON \
    -DENABLE_NOGUI=OFF \
    -DENABLE_GENERIC=OFF \
    -DENABLE_HEADLESS=OFF \
    -DENABLE_TESTS=OFF \
    -DENABLE_CCACHE=OFF \
    -DENABLE_AUTOUPDATE=OFF \
    -DENABLE_ANALYTICS=OFF \
    -DENABLE_SYSTEMD=OFF \
    -DUSE_SYSTEM_LIBMGBA=OFF \
    -DUSE_SYSTEM_CUBEB=OFF \
    -DUSE_SYSTEM_MBEDTLS=OFF
  
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
  install -Dm644 "${_pkgname}/COPYING" \
    "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}
