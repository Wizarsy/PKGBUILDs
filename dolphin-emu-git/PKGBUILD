pkgver() {
  cd "$_pkgname"

  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "$_pkgname"

  _submodules=(Externals/{cubeb/cubeb,mGBA/mgba,cpp-ipc/cpp-ipc,cpp-optparse/cpp-optparse,imgui/imgui,implot/implot,tinygltf/tinygltf,rcheevos/rcheevos,watcher/watcher,VulkanMemoryAllocator})
  for _submodule in "${_submodules[@]}"; do
    git submodule set-url "${_submodule}" "${srcdir}/${_submodule##*/}"
    git -c protocol.file.allow=always submodule update --init "${_submodule}"
  done
  cd Externals/cubeb/cubeb
  git submodule set-url cmake/sanitizers-cmake "${srcdir}/sanitizers-cmake"
  git -c protocol.file.allow=always submodule update --init cmake/sanitizers-cmake
}

build() {
  CC=clang
  CXX=clang++
  LDFLAGS="${LDFLAGS} -fuse-ld=lld"

  export CC CXX LDFLAGS

  _cmake_default=(
    -Wno-author
    -DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON
    -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=ON
    -DCMAKE_SKIP_RPATH=ON
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_C_COMPILER="${CC}"
    -DCMAKE_CXX_COMPILER="${CXX}"
    -DCMAKE_C_FLAGS="${CFLAGS} -DNDEBUG"
    -DCMAKE_CXX_FLAGS="${CXXFLAGS} -DNDEBUG"
    -DCMAKE_EXE_LINKER_FLAGS="${LDFLAGS}"
    -DCMAKE_MODULE_LINKER_FLAGS="${LDFLAGS}"
    -DCMAKE_SHARED_LINKER_FLAGS="${LDFLAGS}"
  )

  cmake -S "$_pkgname" -B build -G Ninja \
    "${_cmake_default[@]}" \
    -DOpenGL_GL_PREFERENCE=GLVND \
    -DQT_NO_PRIVATE_MODULE_WARNING=ON \
    -DCMAKE_DISABLE_FIND_PACKAGE_SYSTEMD=ON \
    -DUSE_SYSTEM_LIBS=ON \
    -DENABLE_TESTS=OFF \
    -DENABLE_AUTOUPDATE=OFF \
    -DENABLE_ANALYTICS=OFF \
    -DUSE_SYSTEM_CUBEB=OFF \
    -DUSE_SYSTEM_MBEDTLS=OFF \
    -DUSE_SYSTEM_LIBMGBA=OFF
  
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -v -Dm644 -t "${pkgdir}/usr/share/licenses/${pkgname}/" \
    "${srcdir}/${_pkgname}/COPYING"
}
