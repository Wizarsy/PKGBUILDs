_pkgname=dolphin-emu
pkgname=${_pkgname}-git
pkgver=2609.r193.g257a6d0
pkgrel=1
pkgdesc='A Nintendo Wii and GameCube emulator'
arch=(x86_64)
url=https://github.com/dolphin-emu/dolphin
license=(GPL-2.0-or-later)
depends=(
  alsa-lib
  bluez-libs
  bzip2
  curl
  enet
  ffmpeg
  fmt
  glslang
  hicolor-icon-theme
  hidapi
  libevdev
  libedit
  libiconv
  libudev.so
  libusb
  libglvnd
  libspng
  libx11
  libxkbcommon
  libxrandr
  libxi
  libxml2
  libpulse
  llvm
  lz4
  lzo
  minizip-ng
  miniupnpc
  pugixml
  qt6-base
  qt6-svg
  sdl3
  sfml
  speexdsp
  xxhash
  xz
  zlib-ng
  zstd
)
makedepends=(
  clang
  cmake
  git
  gettext
  linux-headers
  lld
  ninja
  pkgconf
  python
  vulkan-headers
)
options=(
  !emptydirs
  !lto
)
provides=("$_pkgname")
conflicts=("$_pkgname")
source=(
  "${_pkgname}::git+${url}.git"
  git+https://github.com/mgba-emu/mgba.git
  git+https://github.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator.git
  git+https://github.com/RetroAchievements/rcheevos.git
