pkgver() {
  cd "$_pkgname"

  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "$_pkgname"

  patch -p1 < ../qt-plugins.patch
  patch -p1 < ../fix-missing-headers.patch

  cd "${srcdir}/libpng"
  patch -p1 < "${srcdir}/libpng-1.6.58-apng.patch"

  cd "${srcdir}/QtApng"
  patch -p1 < "${srcdir}/${_pkgname}/.github/workflows/scripts/common/qtapng-cmake.patch"

  cd "${srcdir}/rapidyaml"
  git submodule set-url ext/c4core "${srcdir}/c4core"
  git -c protocol.file.allow=always submodule update --init ext/c4core

  cd ext/c4core
  for submodule in cmake src/c4/ext/{debugbreak,fast_float}; do
    git submodule set-url "${submodule}" "${srcdir}/${submodule##*/}"
    git -c protocol.file.allow=always submodule update --init "${submodule}"
  done
}

build() {
  CC=clang
  CXX=clang++
  LDFLAGS="${LDFLAGS} -fuse-ld=lld"

  export CC CXX LDFLAGS

  external_deps="${srcdir}/deps"

  local cmake_default_flags=(
    -DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON
    -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=ON
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_RPATH="/usr/lib/${_pkgname^^}"
    -DCMAKE_PREFIX_PATH="${external_deps}"
    -DCMAKE_C_COMPILER="${CC}"
    -DCMAKE_CXX_COMPILER="${CXX}"
    -DCMAKE_C_FLAGS="${CFLAGS}"
    -DCMAKE_CXX_FLAGS="${CXXFLAGS}"
    -DCMAKE_EXE_LINKER_FLAGS="${LDFLAGS}"
    -DCMAKE_MODULE_LINKER_FLAGS="${LDFLAGS}"
    -DCMAKE_SHARED_LINKER_FLAGS="${LDFLAGS}"
  )

  cd "${srcdir}/libpng"
  cmake -B build -G Ninja \
    "${cmake_default_flags[@]}" \
    -DCMAKE_INSTALL_PREFIX="${external_deps}" \
    -DBUILD_SHARED_LIBS=ON \
    -DPNG_SHARED=ON \
    -DPNG_TESTS=OFF \
    -DPNG_STATIC=OFF \
    -DPNG_TOOLS=OFF
  cmake --build build
  cmake --install build

  cd "${srcdir}/QtApng"
  cmake -B build -G Ninja \
    "${cmake_default_flags[@]}" \
    -DCMAKE_INSTALL_PREFIX="${external_deps}"
  cmake --build build
  cmake --install build

  cd "${srcdir}/plutovg"
  cmake -B build -G Ninja \
    "${cmake_default_flags[@]}" \
    -DCMAKE_INSTALL_PREFIX="${external_deps}" \
    -DBUILD_SHARED_LIBS=ON \
    -DPLUTOVG_BUILD_EXAMPLES=OFF 
  cmake --build build
  cmake --install build

  cd "${srcdir}/plutosvg"
  cmake -B build -G Ninja \
    "${cmake_default_flags[@]}" \
    -DCMAKE_INSTALL_PREFIX="${external_deps}" \
    -DBUILD_SHARED_LIBS=ON \
    -DPLUTOSVG_ENABLE_FREETYPE=OFF \
    -DPLUTOSVG_BUILD_EXAMPLES=OFF
  cmake --build build
  cmake --install build

  cd "${srcdir}/rapidyaml"
  cmake -B build -G Ninja \
    "${cmake_default_flags[@]}" \
    -DCMAKE_INSTALL_PREFIX="${external_deps}" \
    -DBUILD_SHARED_LIBS=ON
  cmake --build build
  cmake --install build

  cd "$srcdir"

  cmake -S "$_pkgname" -B build -G Ninja \
    "${cmake_default_flags[@]}" \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DOpenGL_GL_PREFERENCE=GLVND \
    -DDISABLE_ADVANCE_SIMD=ON \
    -DENABLE_QT_UI=ON \
    -DPACKAGE_MODE=ON \
    -DENABLE_TESTS=OFF \
    -DENABLE_GSRUNNER=OFF \
    -DENABLE_SETCAP=OFF \
    -DUSE_LINKED_FFMPEG=OFF \
    -DFFMPEG_INCLUDE_DIRS="${srcdir}/${_pkgname}/3rdparty/ffmpeg/include"
  
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "${srcdir}/${_pkgname}/.github/workflows/scripts/linux/pcsx2-qt.desktop" "${pkgdir}/usr/share/applications/net.pcsx2.PCSX2.desktop"
  install -Dm644 "${pkgdir}/usr/share/PCSX2/resources/icons/AppIconLarge.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/PCSX2.png"
  
  mkdir -p "${pkgdir}/usr/share/metainfo"
  cd "${srcdir}/${_pkgname}"
  ".github/workflows/scripts/linux/generate-metainfo.sh" "${pkgdir}/usr/share/metainfo/net.pcsx2.PCSX2.appdata.xml"

  for obj in "${srcdir}/deps/lib/${obj}"/{libpng16.so.16,libryml.so.0.12.1,libplutosvg.so.0,libplutovg.so.1}; do
    install -Dm644 "${obj}" "${pkgdir}/usr/lib/${_pkgname^^}/${obj##*/}"
  done

  install -Dm755 -d "${pkgdir}/usr/lib/${_pkgname^^}/plugins/imageformats"
  install -Dm644 "${srcdir}/deps/plugins/imageformats/"* "${pkgdir}/usr/lib/${_pkgname^^}/plugins/imageformats"

  install -Dm644 "${srcdir}/${_pkgname}/COPYING.GPLv3" \
    "${pkgdir}/usr/share/licenses/${pkgname}/COPYING.GPLv3"
}
