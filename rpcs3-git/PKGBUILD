pkgver() {
  cd $_pkgname

  printf "%s.r%s.%s" "$(awk '/version{.*}/ { printf("%d.%d.%d", $5, $6, $7) }' rpcs3/rpcs3_version.cpp)" "$(git rev-list --count HEAD)" "$(git rev-parse --short=8 HEAD)"
}

prepare() {
  cd $_pkgname

  submodules=(3rdparty/{cubeb/cubeb,yaml-cpp/yaml-cpp,FAudio,wolfssl/wolfssl,SoundTouch/soundtouch,7zip/7zip,stblib/stb,discord-rpc/discord-rpc,GPUOpen/VulkanMemoryAllocator,fusion/fusion,feralinteractive/feralinteractive,asmjit/asmjit})
  for submodule in ${submodules[@]}; do
    git submodule set-url ${submodule} "${srcdir}/${submodule##*/}"
    git -c protocol.file.allow=always submodule update --init ${submodule}
  done

  cd 3rdparty/cubeb/cubeb
  git submodule set-url cmake/sanitizers-cmake "${srcdir}/sanitizers-cmake"
  git -c protocol.file.allow=always submodule update --init cmake/sanitizers-cmake
}

build() {
  CC=clang
  CXX=clang++
  LDFLAGS="${LDFLAGS} -fuse-ld=lld"

  export CC CXX LDFLAGS

  cmake_default_flags=(
    -DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON
    -DCMAKE_SKIP_RPATH=ON
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_C_COMPILER="${CC}"
    -DCMAKE_CXX_COMPILER="${CXX}"
    -DCMAKE_C_FLAGS="${CFLAGS}"
    -DCMAKE_CXX_FLAGS="${CXXFLAGS}"
    -DCMAKE_EXE_LINKER_FLAGS="${LDFLAGS}"
    -DCMAKE_MODULE_LINKER_FLAGS="${LDFLAGS}"
    -DCMAKE_SHARED_LINKER_FLAGS="${LDFLAGS}"
  )

  cmake -S $_pkgname -B build -G Ninja \
    "${cmake_default_flags[@]}" \
    -DOpenGL_GL_PREFERENCE=GLVND \
    -DWITH_LLVM=ON \
    -DUSE_LTO=ON \
    -DUSE_DISCORD_RPC=ON \
    -DUSE_SDL=ON \
    -DUSE_FAUDIO=ON \
    -DUSE_LIBEVDEV=ON \
    -DUSE_VULKAN=ON \
    -DUSE_SYSTEM_CURL=ON \
    -DUSE_SYSTEM_FFMPEG=ON \
    -DUSE_SYSTEM_PROTOBUF=ON \
    -DUSE_SYSTEM_GLSLANG=ON \
    -DUSE_SYSTEM_HIDAPI=ON \
    -DUSE_SYSTEM_LIBPNG=ON \
    -DUSE_SYSTEM_LIBUSB=ON \
    -DUSE_SYSTEM_MINIUPNPC=ON \
    -DUSE_SYSTEM_OPENAL=ON \
    -DUSE_SYSTEM_OPENCV=ON \
    -DUSE_SYSTEM_PUGIXML=ON \
    -DUSE_SYSTEM_RTMIDI=ON \
    -DUSE_SYSTEM_SDL=ON \
    -DUSE_SYSTEM_ZLIB=ON \
    -DUSE_SYSTEM_ZSTD=ON \
    -DSTATIC_LINK_LLVM=OFF \
    -DUSE_NATIVE_INSTRUCTIONS=OFF \
    -DUSE_SYSTEM_WOLFSSL=OFF \
    -DUSE_SYSTEM_VULKAN_MEMORY_ALLOCATOR=OFF \
    -DUSE_SYSTEM_FAUDIO=OFF \
    -DUSE_SYSTEM_CUBEB=OFF \
    -DBUILD_LLVM=OFF \
    -DBUILD_RPCS3_TESTS=OFF \
    -DRUN_RPCS3_TESTS=OFF
  
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
  install -Dm644 "${_pkgname}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
