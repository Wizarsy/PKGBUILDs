pkgver() {
  cd "$_pkgname"

  printf "%s.r%s.%s" "$(awk '/version{.*}/ { printf("%d.%d.%d", $5, $6, $7) }' rpcs3/rpcs3_version.cpp)" "$(git rev-list --count HEAD)" "$(git rev-parse --short=8 HEAD)"
}

prepare() {
  cd "$_pkgname"

  patch -p1 < ../remove-autoupdate.patch

  _submodules=(3rdparty/{cubeb/cubeb,yaml-cpp/yaml-cpp,FAudio,wolfssl/wolfssl,SoundTouch/soundtouch,7zip/7zip,stblib/stb,discord-rpc/discord-rpc,GPUOpen/VulkanMemoryAllocator,fusion/fusion,feralinteractive/feralinteractive,asmjit/asmjit,protobuf/protobuf})
  for _submodule in "${_submodules[@]}"; do
    git submodule set-url "${_submodule}" "${srcdir}/${_submodule##*/}"
    git -c protocol.file.allow=always submodule update --init "${_submodule}"
  done

  cd 3rdparty/cubeb/cubeb
  git submodule set-url cmake/sanitizers-cmake "${srcdir}/sanitizers-cmake"
  git -c protocol.file.allow=always submodule update --init cmake/sanitizers-cmake
}

build() {
  CC=clang
  CXX=clang++
  LDFLAGS="${LDFLAGS} -fuse-ld=lld"

  export CC CXX LDFLAGS

  _cmake_default=(
    -Wno-author
    -DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON
    -DCMAKE_SKIP_RPATH=ON
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_C_COMPILER="${CC}"
    -DCMAKE_CXX_COMPILER="${CXX}"
    -DCMAKE_C_FLAGS="${CFLAGS} -DNDEBUG"
    -DCMAKE_CXX_FLAGS="${CXXFLAGS} -DNDEBUG"
    -DCMAKE_EXE_LINKER_FLAGS="${LDFLAGS}"
    -DCMAKE_MODULE_LINKER_FLAGS="${LDFLAGS}"
    -DCMAKE_SHARED_LINKER_FLAGS="${LDFLAGS}"
  )

  cmake -S "$_pkgname" -B build -G Ninja \
    "${_cmake_default[@]}" \
    -DOpenGL_GL_PREFERENCE=GLVND \
    -DUSE_DISCORD_RPC=ON \
    -DUSE_SYSTEM_ZSTD=ON \
    -DUSE_SYSTEM_FFMPEG=ON \
    -DUSE_SYSTEM_HIDAPI=ON \
    -DUSE_SYSTEM_LIBPNG=ON \
    -DUSE_SYSTEM_LIBUSB=ON \
    -DUSE_SYSTEM_OPENAL=ON \
    -DUSE_SYSTEM_RTMIDI=ON \
    -DUSE_SYSTEM_GLSLANG=ON \
    -DUSE_SYSTEM_PUGIXML=ON \
    -DUSE_SYSTEM_PROTOBUF=ON \
    -DUSE_SYSTEM_MINIUPNPC=ON \
    -DUSE_NATIVE_INSTRUCTIONS=OFF
  
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  
  install -Dm644 -t "${pkgdir}/usr/share/licenses/${pkgname}/" \
    "${srcdir}/${_pkgname}/LICENSE"
}
