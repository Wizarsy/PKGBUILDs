# shellcheck shell=bash
# shellcheck disable=SC2164
# shellcheck disable=SC2154
# shellcheck disable=SC2034

_pkgname=bpftune
pkgname=${_pkgname}-git
pkgver=r772.d5d9f60
pkgrel=1
pkgdesc='BPF/tracing tools for auto-tuning Linux'
arch=(x86_64)
url=https://github.com/oracle/bpftune
license=('GPLv2 WITH Linux-syscall-note')
depends=(
  libbpf
  libnl
  libcap
)
makedepends=(
  clang
  bpf
  git
  lld
  llvm
  linux-headers
  make
  python-docutils
  rpm-tools
)
provides=("$_pkgname")
conflicts=("$_pkgname")
options=(lto)
source=(
  "git+${url}.git"
  build-tweaks.patch
)
sha256sums=('SKIP'
            '1817b5b5580c748c8dfad448489afe1f325f02e194ccbc5c32eaed1d6b1e39c8')

pkgver() {
    cd "$_pkgname"

    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "$_pkgname"

    patch -p1 < ../build-tweaks.patch
}

build() {
  CC=clang
  LDFLAGS="${LDFLAGS} -Wl,--undefined-version -fuse-ld=lld"

  export CC LDFLAGS

  make -C "$_pkgname" \
    libdir=lib \
    SBINPATH=/usr/bin
}

package() {
  make -C "$_pkgname" install \
    DESTDIR="$pkgdir" \
    libdir=lib \
    SBINPATH=/usr/bin

  install -Dm644 -t "${pkgdir}/usr/share/licenses/${pkgname}/" \
    "${srcdir}/${_pkgname}/LICENSE.txt"
}
