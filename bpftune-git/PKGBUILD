# shellcheck shell=bash
# shellcheck disable=SC2164
# shellcheck disable=SC2154
# shellcheck disable=SC2034

_pkgname=bpftune
pkgname=${_pkgname}-git
pkgver=r772.d5d9f60
pkgrel=1
pkgdesc='BPF/tracing tools for auto-tuning Linux'
arch=(x86_64)
url=https://github.com/oracle/bpftune
license=('GPLv2 WITH Linux-syscall-note')
depends=(
  libbpf
  libnl
  libcap
)
makedepends=(
  clang
  bpf
  git
  lld
  llvm
  pkgconf
  python-docutils
)
provides=("$_pkgname")
conflicts=("$_pkgname")
# options=()
source=(
  "git+${url}.git"
  build-tweaks.patch
)
sha256sums=('SKIP'
            '806a3f909cb344ec5794419ae5ff8d47db2be24be7275d0c18651e46e2809d33')

pkgver() {
    cd "$_pkgname"

    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "$_pkgname"

    patch -p1 < ../build-tweaks.patch
}

build() {
  cd "$_pkgname"

  CC=clang
  LDFLAGS="${LDFLAGS} -fuse-ld=lld -Wl,--undefined-version"
  CFLAGS="${CFLAGS} -w"

  export CC CFLAGS LDFLAGS

  make libdir=lib
}

package() {
  cd "$_pkgname"

  make install \
    DESTDIR="$pkgdir" \
    libdir=lib
  install -Dm644 LICENSE.txt \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.txt"
  rm -rf "${pkgdir}/var/lib/systemd"
}
