# shellcheck shell=bash
# shellcheck disable=SC2164
# shellcheck disable=SC2154
# shellcheck disable=SC2034

_pkgname=libretro-mesens
pkgname=${_pkgname}-git
pkgver=0.4.0.r207.g9e4fdeb
pkgrel=1
pkgdesc='Mesen-S is a cross-platform SNES emulator built in C++ (libretro-core)'
groups=(
  libretro-git
  libretro-cores-git
)
arch=(x86_64)
url=https://github.com/libretro/Mesen-S
license=(GPL-3.0-or-later)
# depends=(retroarch-git)
makedepends=(
  clang
  git
  lld
  llvm
  make
  pkgconf
)
provides=(
  "$_pkgname"
  libretro-core
)
conflicts=("$_pkgname")
options=(lto)
source=(
  "${_pkgname}::git+${url}.git"
)
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"

  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd "$_pkgname"

  CC=clang
  CXX=clang++
  AR="llvm-ar"
  RANLIB="llvm-ranlib"
  STRIP="llvm-strip"
  LDFLAGS="${LDFLAGS} -fuse-ld=lld"

  export CC CXX LDFLAGS AR RANLIB STRIP

  make -C Libretro
}

package() {
  install -v -Dm644 -t "${pkgdir}/usr/lib/libretro/" \
    "${srcdir}/${_pkgname}/Libretro/mesen-s_libretro.so"
}
