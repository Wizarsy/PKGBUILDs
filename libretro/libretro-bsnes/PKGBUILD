# shellcheck shell=bash
# shellcheck disable=SC2164
# shellcheck disable=SC2154
# shellcheck disable=SC2034

_pkgname=libretro-bsnes
pkgname=${_pkgname}-git
pkgver=nightly.r1069.g05439f9
pkgrel=1
pkgdesc='A Super Nintendo (SNES) emulator focused on performance, features, and ease of use (libretro-core)'
groups=(libretro-cores-git)
arch=(x86_64)
url=https://github.com/libretro/bsnes-libretro
license=(GPL-3.0-or-later)
depends=(
  openmp
  # retroarch-git
)
makedepends=(
  clang
  git
  lld
  llvm
  make
  pkgconf
)
provides=(
  "$_pkgname"
  libretro-core
)
conflicts=("$_pkgname")
options=(lto)
source=(
  "${_pkgname}::git+${url}.git"
)
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"

  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$_pkgname"

  CC=clang
  CXX=clang++
  AR="llvm-ar"
  RANLIB="llvm-ranlib"
  STRIP="llvm-strip"
  LDFLAGS="${LDFLAGS} -fuse-ld=lld"

  export CC CXX LDFLAGS AR RANLIB STRIP

  make -C bsnes \
    local=false \
    binary=library \
    compiler="${CXX}" \
    target=libretro
}

package() {
  install -v -Dm644 -t "${pkgdir}/usr/lib/libretro/" \
    "${srcdir}/${_pkgname}/bsnes/out/bsnes_libretro.so"
}
