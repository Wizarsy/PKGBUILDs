# Maintainer: Filipe B. Madruga <filipemadruga@outlook.com>

# shellcheck shell=bash
# shellcheck disable=SC2164
# shellcheck disable=SC2154
# shellcheck disable=SC2034

_pkgname=libretro-cemu
pkgname=${_pkgname}-git
pkgver=r1523.91fb753a
pkgrel=1
pkgdesc='Cemu - Wii U emulator (libretro-core)'
groups=(libretro-cores-git)
arch=(x86_64)
url=https://github.com/WizzardSK/cemu-libretro
license=(MPL-2.0)
depends=(
  boost-libs
  curl
  fmt
  glslang
  libusb
  libglvnd
  libpng
  libx11
  libxext
  libxrender
  libzip
  openssl
  pugixml
  # retroarch-git
  zlib
  zstd
)
makedepends=(
  boost
  clang
  cmake
  git
  glm
  lld
  llvm
  nasm
  ninja
  rapidjson
  pkgconf
  vulkan-headers
)
provides=(
  "$_pkgname"
  libretro-core
)
conflicts=("$_pkgname")
options=(!lto)
source=(
  "${_pkgname}::git+${url}.git"
  git+https://github.com/ocornut/imgui.git
  git+https://github.com/WizzardSK/ZArchive.git
  git+https://github.com/cemu-project/cemu_graphic_packs.git
)
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

pkgver() {
  cd "$_pkgname"

  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$_pkgname"

  sed -i "/find_package(libusb CONFIG)/s/)$/ QUIET)/" cmake/Findlibusb.cmake

  _submodules=(dependencies/{imgui,ZArchive,cemu_graphic_packs})
  for _submodule in "${_submodules[@]}"; do
    git submodule set-url "${_submodule}" "${srcdir}/${_submodule##*/}"
    git -c protocol.file.allow=always submodule update --init "${_submodule}"
  done
}

build() {
  CC=clang
  CXX=clang++
  LDFLAGS="${LDFLAGS} -fuse-ld=lld"

  export CC CXX LDFLAGS

  _cmake_default=(
    -Wno-author
    -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=ON
    -DCMAKE_SKIP_RPATH=ON
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_C_COMPILER="${CC}"
    -DCMAKE_CXX_COMPILER="${CXX}"
    -DCMAKE_C_FLAGS="${CFLAGS} -DNDEBUG"
    -DCMAKE_CXX_FLAGS="${CXXFLAGS} -DNDEBUG"
    -DCMAKE_EXE_LINKER_FLAGS="${LDFLAGS}"
    -DCMAKE_MODULE_LINKER_FLAGS="${LDFLAGS}"
    -DCMAKE_SHARED_LINKER_FLAGS="${LDFLAGS}"
  )

  cmake -S "$_pkgname" -B build -G Ninja \
    "${_cmake_default[@]}" \
    -DOpenGL_GL_PREFERENCE=GLVND \
    -DENABLE_VCPKG=OFF \
    -DENABLE_WAYLAND=OFF
  
  cmake --build build --target cemu_libretro
}

package() {
  install -v -Dm644 -t "${pkgdir}/usr/lib/libretro/" \
    "${srcdir}/${_pkgname}/bin/cemu_libretro.so"
}
