# shellcheck shell=bash
# shellcheck disable=SC2164
# shellcheck disable=SC2154
# shellcheck disable=SC2034

_pkgname=libretro-amiberry
pkgname=${_pkgname}-git
pkgver=8.5.0.r82.gdf7eaab
pkgrel=1
pkgdesc='Optimized multi-platform Amiga emulator (libretro-core)'
groups=(
  libretro-git
  libretro-cores-git
)
arch=(x86_64)
url=https://github.com/BlitterStudio/amiberry
license=(GPL-3.0-only)
depends=(
  # retroarch-git
  zlib
)
makedepends=(
  clang
  git
  lld
  llvm
  make
  pkgconf
)
provides=(
  "$_pkgname"
  libretro-core
)
conflicts=("$_pkgname")
options=(lto)
source=(
  "${_pkgname}::git+${url}.git"
  git+https://github.com/libretro/libretro-common.git
  git+https://github.com/higan-emu/libco.git
)
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

pkgver() {
  cd "$_pkgname"

  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "$_pkgname"

  _submodules=(libretro/{libretro-common,libco})
  for _submodule in "${_submodules[@]}"; do
    git submodule set-url "${_submodule}" "${srcdir}/${_submodule##*/}"
    git -c protocol.file.allow=always submodule update --init "${_submodule}"
  done
}

build() {
  cd "$_pkgname"

  CC=clang
  CXX=clang++
  CFLAGS="${CFLAGS} -DNDEBUG"
  CXXFLAGS="${CXXFLAGS} -DNDEBUG"
  LDFLAGS="${LDFLAGS} -fuse-ld=lld"
  AR="llvm-ar"
  NM="llvm-nm"
  STRIP="llvm-strip"
  OBJCOPY="llvm-objcopy"
  OBJDUMP="llvm-objdump"
  RANLIB="llvm-ranlib"
  DLLTOOL="llvm-dlltool"
  READELF="llvm-readelf"
  ADDR2LINE="llvm-addr2line"
  
  export CC CXX CFLAGS CXX FLAGSLDFLAGS AR NM STRIP RANLIB OBJCOPY OBJDUMP DLLTOOL READELF ADDR2LINE

  make -C libretro
}

package() {
  install -v -Dm644 -t "${pkgdir}/usr/lib/libretro/" \
    "${srcdir}/${_pkgname}/libretro/amiberry_libretro.so"
}
