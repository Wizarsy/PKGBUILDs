# shellcheck shell=bash
# shellcheck disable=SC2164
# shellcheck disable=SC2154
# shellcheck disable=SC2034

_pkgname=libretro-dolphin
pkgname=${_pkgname}-git
pkgver=2609.r460.g32c61f9
pkgrel=1
pkgdesc='A Nintendo Wii and GameCube emulator (libretro-core)'
groups=(libretro-cores-git)
arch=(x86_64)
url=https://github.com/libretro/dolphin
license=(GPL-2.0-or-later)
depends=(
  bzip2
  curl
  enet
  fmt
  glslang
  hidapi
  libiconv
  libglvnd
  libspng
  libusb
  libxml2
  lz4
  lzo
  minizip-ng
  pugixml
  # retroarch-git
  sfml
  xxhash
  xz
  zlib-ng
  zstd
)
makedepends=(
  clang
  cmake
  git
  linux-headers
  lld
  llvm
  ninja
  pkgconf
  python
  vulkan-headers
)
provides=(
  "$_pkgname"
  libretro-core
)
conflicts=("$_pkgname")
options=(!lto)
source=(
  "${_pkgname}::git+${url}.git"
  git+https://github.com/mgba-emu/mgba.git
  git+https://github.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator.git
  git+https://github.com/ocornut/imgui.git
  git+https://github.com/epezent/implot.git
  git+https://github.com/syoyo/tinygltf.git
  git+https://github.com/e-dant/watcher.git
  git+https://github.com/mutouyun/cpp-ipc.git
  git+https://github.com/weisslj/cpp-optparse.git
)
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

pkgver() {
  cd "$_pkgname"

  git describe --long --tags --abbrev=7 | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "$_pkgname"

  _submodules=(Externals/{mGBA/mgba,cpp-ipc/cpp-ipc,cpp-optparse/cpp-optparse,imgui/imgui,implot/implot,tinygltf/tinygltf,watcher/watcher,VulkanMemoryAllocator})
  for _submodule in "${_submodules[@]}"; do
    git submodule set-url "${_submodule}" "${srcdir}/${_submodule##*/}"
    git -c protocol.file.allow=always submodule update --init "${_submodule}"
  done
}

build() {
  CC=clang
  CXX=clang++
  LDFLAGS="${LDFLAGS} -fuse-ld=lld"

  export CC CXX LDFLAGS

  _cmake_default=(
    -Wno-author
    -DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON
    -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=ON
    -DCMAKE_SKIP_RPATH=ON
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_C_COMPILER="${CC}"
    -DCMAKE_CXX_COMPILER="${CXX}"
    -DCMAKE_C_FLAGS="${CFLAGS} -DNDEBUG"
    -DCMAKE_CXX_FLAGS="${CXXFLAGS} -DNDEBUG"
    -DCMAKE_EXE_LINKER_FLAGS="${LDFLAGS}"
    -DCMAKE_MODULE_LINKER_FLAGS="${LDFLAGS}"
    -DCMAKE_SHARED_LINKER_FLAGS="${LDFLAGS}"
  )

  cmake -S "$_pkgname" -B build -G Ninja \
    "${_cmake_default[@]}" \
    -DOpenGL_GL_PREFERENCE=GLVND \
    -DCMAKE_DISABLE_FIND_PACKAGE_SYSTEMD=ON \
    -DLIBRETRO=ON \
    -DUSE_SYSTEM_LIBS=ON \
    -DENABLE_X11=OFF \
    -DENABLE_EGL=OFF \
    -DENABLE_HWDB=OFF \
    -DENABLE_BLUEZ=OFF \
    -DUSE_SYSTEM_LIBMGBA=OFF \
    -DUSE_SYSTEM_MBEDTLS=OFF
  
  cmake --build build
}

package() {
  install -v -Dm644 -t "${pkgdir}/usr/lib/libretro/" \
    "${srcdir}/build/dolphin_libretro.so"
}
