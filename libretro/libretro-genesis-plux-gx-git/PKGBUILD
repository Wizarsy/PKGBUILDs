# Maintainer: Filipe B. Madruga <filipemadruga@outlook.com>

# shellcheck shell=bash
# shellcheck disable=SC2164
# shellcheck disable=SC2154
# shellcheck disable=SC2034

_pkgname=libretro-genesis-plux-gx
pkgname=${_pkgname}-git
pkgver=r2403.b9c23164
pkgrel=1
pkgdesc='An enhanced port of Genesis Plus - accurate & portable Sega 8/16 bit emulator (libretro-core)'
groups=(
  libretro-git
  libretro-cores-git
)
arch=(x86_64)
url=https://github.com/libretro/Genesis-Plus-GX
license=(GPL-3.0-or-later)
# depends=(retroarch-git)
makedepends=(
  clang
  git
  lld
  llvm
  make
  pkgconf
)
provides=(
  "$_pkgname"
  libretro-core
)
conflicts=("$_pkgname")
options=(lto)
source=("${_pkgname}::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"

  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$_pkgname"

  CC=clang
  CXX=clang++
  LD="lld"
  CFLAGS="${CFLAGS} -DNDEBUG"
  CXXFLAGS="${CXXFLAGS} -DNDEBUG"
  LDFLAGS="${LDFLAGS} -fuse-ld=lld"
  AR="llvm-ar"
  NM="llvm-nm"
  STRIP="llvm-strip"
  OBJCOPY="llvm-objcopy"
  OBJDUMP="llvm-objdump"
  RANLIB="llvm-ranlib"
  DLLTOOL="llvm-dlltool"
  READELF="llvm-readelf"
  ADDR2LINE="llvm-addr2line"

  export CC CXX LD CFLAGS CXX FLAGSLDFLAGS AR NM STRIP RANLIB OBJCOPY OBJDUMP DLLTOOL READELF ADDR2LINE

  make -f Makefile.libretro
}

package() {
  install -v -Dm644 -t "${pkgdir}/usr/lib/libretro/" \
    "${srcdir}/${_pkgname}/genesis_plus_gx_libretro.so"
}
