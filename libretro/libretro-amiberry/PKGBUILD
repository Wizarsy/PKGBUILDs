# Maintainer: Filipe B. Madruga <filipemadruga@outlook.com>

# shellcheck shell=bash
# shellcheck disable=SC2164
# shellcheck disable=SC2154
# shellcheck disable=SC2034

_pkgname=libretro-amiberry
pkgname=${_pkgname}-git
pkgver=8.4.2.r35.g911844c
pkgrel=1
pkgdesc='Optimized multi-platform Amiga emulator (libretro-core)'
groups=(libretro-cores-git)
arch=(x86_64)
url=https://github.com/BlitterStudio/amiberry
license=(GPL-3.0-only)
depends=(
  # retroarch-git
  zlib
)
makedepends=(
  clang
  git
  lld
  llvm
  make
  pkgconf
)
provides=(
  "$_pkgname"
  libretro-core
)
conflicts=("$_pkgname")
options=(lto)
source=(
  "${_pkgname}::git+${url}.git"
  git+https://github.com/libretro/libretro-common.git
  git+https://github.com/higan-emu/libco.git
  git+https://github.com/btzy/nativefiledialog-extended.git
)
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

pkgver() {
  cd "$_pkgname"

  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "$_pkgname"

  _submodules=(libretro/{libretro-common,libco})
  for _submodule in "${_submodules[@]}"; do
    git submodule set-url "${_submodule}" "${srcdir}/${_submodule##*/}"
    git -c protocol.file.allow=always submodule update --init "${_submodule}"
  done

  git submodule set-url external/nativefiledialog-extended "${srcdir}/nativefiledialog-extended"
  git -c protocol.file.allow=always submodule update --init external/nativefiledialog-extended
}

build() {
  cd "$_pkgname"

  CC=clang
  CXX=clang++
  AR="llvm-ar"
  RANLIB="llvm-ranlib"
  STRIP="llvm-strip"
  LDFLAGS="${LDFLAGS} -fuse-ld=lld"

  export CC CXX LDFLAGS AR RANLIB STRIP

  make -C libretro
}

package() {
  install -v -Dm644 -t "${pkgdir}/usr/lib/libretro/" \
    "${srcdir}/${_pkgname}/libretro/amiberry_libretro.so"
}
