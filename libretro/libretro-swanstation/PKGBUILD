# shellcheck shell=bash
# shellcheck disable=SC2164
# shellcheck disable=SC2154
# shellcheck disable=SC2034

_pkgname=libretro-swanstation
pkgname=${_pkgname}-git
pkgver=r6201.631f0fb3
pkgrel=1
pkgdesc='SwanStation is a hard fork and open-source Libretro core implementation of DuckStation (libretro-core)'
groups=(libretro-cores-git)
arch=(x86_64)
url=https://github.com/libretro/swanstation
license=(GPL-3.0-only)
# depends=(retroarch-git)
makedepends=(
  clang
  git
  lld
  llvm
  make
)
provides=(
  "$_pkgname"
  libretro-core
)
conflicts=("$_pkgname")
options=(lto)
source=("${_pkgname}::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"

  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$_pkgname"

  sed -Ei "s/-O3|-O2//" Makefile.libretro
}

build() {
  CC=clang
  CXX=clang++
  AR="llvm-ar"
  RANLIB="llvm-ranlib"
  STRIP="llvm-strip"
  LDFLAGS="${LDFLAGS} -fuse-ld=lld"

  export CC CXX LDFLAGS AR RANLIB STRIP

  make -C "$_pkgname" -f Makefile.libretro \
    platform=unix
}

package() {
  install -v -Dm644 -t "${pkgdir}/usr/lib/libretro/" \
    "${srcdir}/${_pkgname}/swanstation_libretro.so"
}
