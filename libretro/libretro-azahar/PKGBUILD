pkgver() {
  cd "$_pkgname"

  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "$_pkgname"

  patch -p1 < ../build-tweaks.patch

  _submodules=(externals/{vma,teakra,dynarmic,xbyak,microtar,zstd,dds-ktx,nihstro,libretro-common/libretro-common,lodepng/lodepng,sirit/sirit})
  for _submodule in "${_submodules[@]}"; do
    git submodule set-url "${_submodule}" "${srcdir}/${_submodule##*/}"
    git -c protocol.file.allow=always submodule update --init "${_submodule}"
  done

  git submodule set-url dist/compatibility_list "${srcdir}/compatibility-list"
  git -c protocol.file.allow=always submodule update --init dist/compatibility_list

  cd externals/dynarmic

  for _submodule in externals/{mcl,robin-map,zydis,zycore}; do
    git submodule set-url "${_submodule}" "${srcdir}/${_submodule##*/}"
    git -c protocol.file.allow=always submodule update --init "${_submodule}"
  done
}

build() {
  CC=clang
  CXX=clang++
  LDFLAGS="${LDFLAGS} -fuse-ld=lld"

  export CC CXX LDFLAGS

  _cmake_default=(
    -Wno-author
    -DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON
    -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=ON
    -DCMAKE_SKIP_RPATH=ON
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_C_COMPILER="${CC}"
    -DCMAKE_CXX_COMPILER="${CXX}"
    -DCMAKE_C_FLAGS="${CFLAGS} -DNDEBUG"
    -DCMAKE_CXX_FLAGS="${CXXFLAGS} -DNDEBUG"
    -DCMAKE_EXE_LINKER_FLAGS="${LDFLAGS}"
    -DCMAKE_MODULE_LINKER_FLAGS="${LDFLAGS}"
    -DCMAKE_SHARED_LINKER_FLAGS="${LDFLAGS}"
  )

  _sse42=ON

  if [ -z "$PACKAGECARCH" ] || ! [[ "$PACKAGECARCH" =~ x86_64_v[2-4] ]]; then
    _sse42=OFF
  fi

  cmake -S "$_pkgname" -B build -G Ninja \
    "${_cmake_default[@]}" \
    -DENABLE_SSE42="${_sse42}" \
    -DENABLE_LIBRETRO=ON \
    -DUSE_SYSTEM_LIBS=ON \
    -DUSE_SYSTEM_FAAD=ON \
    -DUSE_SYSTEM_XXHASH=ON \
    -DUSE_SYSTEM_SPIRV_TOOLS=ON \
    -DDISABLE_SYSTEM_VMA=ON \
    -DDISABLE_SYSTEM_ZSTD=ON \
    -DDISABLE_SYSTEM_XBYAK=ON \
    -DDISABLE_SYSTEM_LODEPNG=ON \
    -DDISABLE_SYSTEM_DYNARMIC=ON \
    -DDISABLE_SYSTEM_CPP_HTTPLIB=ON \
    -DCMAKE_DISABLE_FIND_PACKAGE_mcl=ON \
    -DCMAKE_DISABLE_FIND_PACKAGE_Zydis=ON \
    -DCMAKE_DISABLE_FIND_PACKAGE_tsl-robin-map=ON \
    -DENABLE_QT=OFF \
    -DENABLE_LTO=OFF \
    -DENABLE_ROOM=OFF \
    -DENABLE_SDL2=OFF \
    -DENABLE_CUBEB=OFF \
    -DENABLE_TESTS=OFF \
    -DENABLE_LIBUSB=OFF \
    -DENABLE_FFMPEG=OFF \
    -DENABLE_OPENAL=OFF \
    -DENABLE_FREECAM=OFF \
    -DENABLE_GDBSTUB=OFF \
    -DENABLE_SCRIPTING=OFF \
    -DENABLE_WEB_SERVICE=OFF \
    -DENABLE_ROOM_STANDALONE=OFF \
    -DENABLE_NATIVE_OPTIMIZATION=OFF \
    -DCITRA_USE_PRECOMPILED_HEADERS=OFF
  
  cmake --build build --target citra_libretro
}

package() {
  install -v -Dm644 -t "${pkgdir}/usr/lib/libretro/" \
    "${srcdir}/build/bin/Release/azahar_libretro.so"
}
