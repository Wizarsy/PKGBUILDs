  zstd
)
makedepends=(
  boost
  clang
  cmake
  git
  libinih
  lld
  llvm
  ninja
  nlohmann-json
  pkgconf
  shaderc
  spirv-headers
  vulkan-icd-loader
  vulkan-headers
)
provides=(
  "$_pkgname"
  libretro-core
)
conflicts=("$_pkgname")
options=(!lto)
source=(
  "${_pkgname}::git+${url}.git"
  vma::git+https://github.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator.git
  git+https://github.com/azahar-emu/compatibility-list.git
