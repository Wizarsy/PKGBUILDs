_pkgname=libretro-azahar
pkgname=${_pkgname}-git
pkgver=2127.0.rc2.r0.g6b4e7f2
pkgrel=1
pkgdesc='An open-source 3DS emulator project based on Citra (libretro-core)'
groups=(libretro-cores-git)
arch=(x86_64)
url=https://github.com/azahar-emu/azahar
license=(GPL-2.0-or-later)
depends=(
  boost-libs
  crypto++
  enet
  faad2
  fmt
  glslang
  openssl
  # retroarch-git
  soundtouch
