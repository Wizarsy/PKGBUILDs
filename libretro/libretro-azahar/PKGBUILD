  git+https://github.com/facebook/zstd.git
  git+https://github.com/septag/dds-ktx.git
  git+https://github.com/neobrain/nihstro.git
  git+https://github.com/azahar-emu/dynarmic.git
  git+https://github.com/azahar-emu/mcl.git
  git+https://github.com/Tessil/robin-map.git
