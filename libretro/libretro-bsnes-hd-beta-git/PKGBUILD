# Maintainer: Filipe B. Madruga <filipemadruga@outlook.com>

# shellcheck shell=bash
# shellcheck disable=SC2164
# shellcheck disable=SC2154
# shellcheck disable=SC2034

_pkgname=libretro-bsnes-hd-beta
pkgname=${_pkgname}-git
pkgver=r57.fc26b25
pkgrel=1
pkgdesc='A bsnes fork that adds HD video features (libretro-core)'
groups=(
  libretro-git
  libretro-cores-git
)
arch=(x86_64)
url=https://github.com/DerKoun/bsnes-hd
license=(GPL-3.0-or-later)
depends=(
  openmp
  # retroarch-git
)
makedepends=(
  clang
  git
  lld
  llvm
  make
  pkgconf
)
provides=(
  "$_pkgname"
  libretro-core
)
conflicts=("$_pkgname")
options=(!lto)
source=("${_pkgname}::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"

  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$_pkgname"

  sed -i "/^compiler.c / s/$/ \$(CFLAGS)/" nall/GNUmakefile
  sed -i "/^compiler.cpp / s/$/ \$(CXXFLAGS)/" nall/GNUmakefile
  sed -i "s/\$(options)/\$(options) \$(LDFLAGS)/" bsnes/target-libretro/GNUmakefile
}

build() {
  cd "$_pkgname"

  CC=clang
  CXX=clang++
  CFLAGS="${CFLAGS} -DNDEBUG"
  CXXFLAGS="${CXXFLAGS} -DNDEBUG"
  LDFLAGS="${LDFLAGS} -fuse-ld=lld"
  AR="llvm-ar"
  NM="llvm-nm"
  STRIP="llvm-strip"
  OBJCOPY="llvm-objcopy"
  OBJDUMP="llvm-objdump"
  RANLIB="llvm-ranlib"
  DLLTOOL="llvm-dlltool"
  READELF="llvm-readelf"
  ADDR2LINE="llvm-addr2line"

  export CC CXX CFLAGS CXX FLAGSLDFLAGS AR NM STRIP RANLIB OBJCOPY OBJDUMP DLLTOOL READELF ADDR2LINE

  make -C bsnes -p \
    compiler="${CXX}" \
    local=false \
    lto=true \
    binary=library \
    target=libretro
}

package() {
  install -v -Dm644 -t "${pkgdir}/usr/lib/libretro/" \
    "${srcdir}/${_pkgname}/bsnes/out/bsnes_hd_beta_libretro.so"
}
