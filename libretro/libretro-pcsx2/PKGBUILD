# shellcheck shell=bash
# shellcheck disable=SC2164
# shellcheck disable=SC2154
# shellcheck disable=SC2034

_pkgname=libretro-pcsx2
pkgname=${_pkgname}-git
pkgver=r20944.6516f15e0
pkgrel=1
pkgdesc='A Sony PlayStation 2 emulator (libreto core)'
groups=(libretro-cores-git)
arch=(x86_64)
url=https://github.com/libretro/ps2
license=(GPL-3.0-only)
depends=(
  libpcap
# retroarch-git
)
makedepends=(
  clang
  git
  lld
  llvm
  make
)
provides=(
  "$_pkgname"
  libretro-core
)
conflicts=("$_pkgname")
options=(lto)
source=("${_pkgname}::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"

  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  CC=clang
  CXX=clang++
  AR="llvm-ar"
  RANLIB="llvm-ranlib"
  STRIP="llvm-strip"
  LDFLAGS="${LDFLAGS} -fuse-ld=lld"

  export CC CXX LDFLAGS AR RANLIB STRIP

  make -C "$_pkgname" \
    HAVE_PCAP=1 \
    ENABLE_MULTI_ISA=0
}

package() {
  install -v -Dm644 -t "${pkgdir}/usr/lib/libretro/" \
    "${srcdir}/${_pkgname}/pcsx2_libretro.so"
}
