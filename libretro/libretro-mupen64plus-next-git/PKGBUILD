# Maintainer: Filipe B. Madruga <filipemadruga@outlook.com>

# shellcheck shell=bash
# shellcheck disable=SC2164
# shellcheck disable=SC2154
# shellcheck disable=SC2034

_pkgname=libretro-mupen64plus-next
pkgname=${_pkgname}-git
pkgver=r551.15bada85
pkgrel=1
pkgdesc='Improved mupen64plus libretro core reimplementation (libretro-core)'
groups=(
  libretro-git
  libretro-cores-git
)
arch=(x86_64)
url=https://github.com/libretro/mupen64plus-libretro-nx
license=(GPL-2.0-or-later)
depends=(
  libpng
  libglvnd
  zlib
)
makedepends=(
  clang
  git
  lld
  llvm
  make
  minizip
  nasm
  pkgconf
  xxhash
)
provides=(
  "$_pkgname"
  libretro-core
)
conflicts=("$_pkgname")
options=(!lto)
source=("${_pkgname}::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"

  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$_pkgname"

  sed -i "/std::fill(std::begin(cmd), std::end(cmd), GBI_Unknown)/s/GBI_Unknown/\&GBI_Unknown/" GLideN64/src/GBI.cpp
  sed -i "/#include <unzip.h>/s|<unzip.h>|<minizip/unzip.h>|" mupen64plus-core/src/main/savestates.c
  sed -i "/#include <zip.h>/s|<zip.h>|<minizip/zip.h>|" mupen64plus-core/src/main/savestates.c
}

build() {
  CC=clang
  CXX=clang++
  AR="llvm-ar"
  RANLIB="llvm-ranlib"
  STRIP="llvm-strip"
  LDFLAGS="${LDFLAGS} -fuse-ld=lld"

  export CC CXX LDFLAGS AR RANLIB STRIP

  make -C "$_pkgname" \
    SYSTEM_LIBPNG=1 \
    SYSTEM_MINIZIP=1 \
    SYSTEM_XXHASH=1 \
    SYSTEM_ZLIB=1 \
    HAVE_PARALLEL_RDP=1 \
    HAVE_PARALLEL_RSP=1 \
    HAVE_THR_AL=1 \
    LLE=1
}

package() {
  install -v -Dm644 -t "${pkgdir}/usr/lib/libretro/" \
    "${srcdir}/${_pkgname}/mupen64plus_next_libretro.so"
}
