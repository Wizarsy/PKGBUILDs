pkgver() {
  cd "$_pkgname"

  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "$_pkgname"

  patch -p1 < ../build-tweaks.patch

  cd "${srcdir}/libpng"
  patch -p1 < "${srcdir}/libpng-1.6.58-apng.patch"

  cd "${srcdir}/QtApng"
  patch -p1 < "${srcdir}/${_pkgname}/.github/workflows/scripts/common/qtapng-cmake.patch"

  cd "${srcdir}/rapidyaml"
  git submodule set-url ext/c4core "${srcdir}/c4core"
  git -c protocol.file.allow=always submodule update --init ext/c4core

  cd ext/c4core
  for _submodule in cmake src/c4/ext/{debugbreak,fast_float}; do
    git submodule set-url "${_submodule}" "${srcdir}/${_submodule##*/}"
    git -c protocol.file.allow=always submodule update --init "${_submodule}"
  done
}

build() {
  CC=clang
  CXX=clang++
  LDFLAGS="${LDFLAGS} -fuse-ld=lld"

  export CC CXX LDFLAGS

  _external_deps="${srcdir}/deps"

  _cmake_default=(
    -Wno-author
    -DCMAKE_DISABLE_PRECOMPILE_HEADERS=ON
    -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=ON
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_RPATH="/usr/lib/PCSX2"
    -DCMAKE_PREFIX_PATH="${_external_deps}"
    -DCMAKE_EXE_LINKER_FLAGS="${LDFLAGS}"
    -DCMAKE_MODULE_LINKER_FLAGS="${LDFLAGS}"
    -DCMAKE_SHARED_LINKER_FLAGS="${LDFLAGS}"
  )

  cd "${srcdir}/libpng"
  cmake -B build -G Ninja \
    "${_cmake_default[@]}" \
    -DCMAKE_C_COMPILER="${CC}" \
    -DCMAKE_C_FLAGS="${CFLAGS} -DNDEBUG" \
    -DCMAKE_INSTALL_PREFIX="${_external_deps}" \
    -DBUILD_SHARED_LIBS=ON \
    -DPNG_SHARED=ON \
    -DPNG_TESTS=OFF \
    -DPNG_STATIC=OFF \
    -DPNG_TOOLS=OFF
  cmake --build build
  cmake --install build

  cd "${srcdir}/QtApng"
  cmake -B build -G Ninja \
    "${_cmake_default[@]}" \
    -DCMAKE_CXX_COMPILER="${CXX}" \
    -DCMAKE_CXX_FLAGS="${CXXFLAGS} -DNDEBUG" \
    -DCMAKE_INSTALL_PREFIX="${_external_deps}"
  cmake --build build
  cmake --install build

  cd "${srcdir}/plutovg"
  cmake -B build -G Ninja \
    "${_cmake_default[@]}" \
    -DCMAKE_C_COMPILER="${CC}" \
    -DCMAKE_C_FLAGS="${CFLAGS} -DNDEBUG" \
    -DCMAKE_INSTALL_PREFIX="${_external_deps}" \
    -DBUILD_SHARED_LIBS=OFF \
    -DPLUTOVG_BUILD_EXAMPLES=OFF 
  cmake --build build
  cmake --install build

  cd "${srcdir}/plutosvg"
  cmake -B build -G Ninja \
    "${_cmake_default[@]}" \
    -DCMAKE_C_COMPILER="${CC}" \
    -DCMAKE_C_FLAGS="${CFLAGS} -DNDEBUG" \
    -DCMAKE_INSTALL_PREFIX="${_external_deps}" \
    -DBUILD_SHARED_LIBS=OFF \
    -DPLUTOSVG_ENABLE_FREETYPE=OFF \
    -DPLUTOSVG_BUILD_EXAMPLES=OFF
  cmake --build build
  cmake --install build

  cd "${srcdir}/rapidyaml"
  cmake -B build -G Ninja \
    "${_cmake_default[@]}" \
    -DCMAKE_CXX_COMPILER="${CXX}" \
    -DCMAKE_CXX_FLAGS="${CXXFLAGS} -DNDEBUG" \
    -DCMAKE_INSTALL_PREFIX="${_external_deps}" \
    -DBUILD_SHARED_LIBS=OFF
  cmake --build build
  cmake --install build

  cd "$srcdir"

  cmake -S "$_pkgname" -B build -G Ninja \
    "${_cmake_default[@]}" \
    -DCMAKE_C_COMPILER="${CC}" \
    -DCMAKE_CXX_COMPILER="${CXX}" \
    -DCMAKE_C_FLAGS="${CFLAGS} -DNDEBUG" \
    -DCMAKE_CXX_FLAGS="${CXXFLAGS} -DNDEBUG" \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DOpenGL_GL_PREFERENCE=GLVND \
    -DQT_NO_PRIVATE_MODULE_WARNING=ON \
    -DENABLE_QT_UI=ON \
    -DPACKAGE_MODE=ON \
    -DUSE_LINKED_FFMPEG=ON \
    -DUSE_VTUNE=OFF \
    -DENABLE_TESTS=OFF \
    -DENABLE_SETCAP=OFF \
    -DENABLE_GSRUNNER=OFF \
    -DDISABLE_ADVANCE_SIMD=OFF
  
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 "${srcdir}/${_pkgname}/.github/workflows/scripts/linux/pcsx2-qt.desktop" \
    "${pkgdir}/usr/share/applications/net.pcsx2.PCSX2.desktop"

  install -Dm644 "${pkgdir}/usr/share/PCSX2/resources/icons/AppIconLarge.png" \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/PCSX2.png"
   
  install -Dm644 -t "${pkgdir}/usr/lib/PCSX2/" \
    "${srcdir}/deps/lib/libpng16.so.16"

  install -Dm644 -t "${pkgdir}/usr/lib/PCSX2/plugins/imageformats/" \
    "${srcdir}/deps/plugins/imageformats/"*

  install -Dm644 -t "${pkgdir}/usr/share/licenses/${pkgname}/" \
    "${srcdir}/${_pkgname}/COPYING.GPLv3"    

  cd "${srcdir}/${_pkgname}"
  install -Dm755 -d "${pkgdir}/usr/share/metainfo"
  ".github/workflows/scripts/linux/generate-metainfo.sh" \
    "${pkgdir}/usr/share/metainfo/net.pcsx2.PCSX2.appdata.xml"
}
