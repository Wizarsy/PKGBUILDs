_pkgname=pcsx2
pkgname=${_pkgname}-git
pkgver=2.9.160.r0.ga6dc70b
pkgrel=1
pkgdesc='A Sony PlayStation 2 emulator'
arch=(x86_64)
url=https://github.com/PCSX2/pcsx2
license=(GPL-3.0-only)
depends=(
  # curl
  cpuinfo
  ffmpeg
  # fontconfig
  hicolor-icon-theme
  kddockwidgets
  libbacktrace
  # libpng
  # libwebp
  # libdbus-1.so
  libpcap
  libudev.so
  libxi
  libxrandr
  libzip
  # lz4
  opengl-driver
  qt6-base
  qt6-declarative
  sdl3
  shaderc
  # libjpeg-turbo
  # zlib
  # zstd
)
optdepends=("${_pkgname}_patches")
makedepends=(
  clang
  cmake
  extra-cmake-modules
  git
  libglvnd
  lld
  llvm
  ninja
  pkgconf
  qt6-tools
  vulkan-headers
)
provides=("$_pkgname")
conflicts=("$_pkgname")
options=(
  !emptydirs
  !lto
)
source=(
  "git+${url}.git"
  build-tweaks.patch
  git+https://github.com/sammycage/plutovg.git#tag=v1.3.3
  git+https://github.com/sammycage/plutosvg.git#tag=v0.0.8
  git+https://github.com/jurplel/QtApng.git#tag=1.3.0
  git+https://github.com/pnggroup/libpng.git#tag=v1.6.58
  https://download.sourceforge.net/libpng-apng/libpng-1.6.58-apng.patch.gz
  git+https://github.com/biojppm/rapidyaml.git#tag=v0.12.1
  git+https://github.com/biojppm/c4core.git
  git+https://github.com/biojppm/cmake.git
  git+https://github.com/biojppm/debugbreak.git
  git+https://github.com/fastfloat/fast_float.git
)
sha256sums=('SKIP'
            '1c7595f3847417edd3881c221199852b832fda2661e4552961095600d42b6833'
