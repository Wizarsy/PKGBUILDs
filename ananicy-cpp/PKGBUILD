# Maintainer: Filipe B. Madruga <filipemadruga@outlook.com>

pkgname=ananicy-cpp
pkgver=1.2.0
pkgrel=1
pkgdesc='Ananicy Cpp is a full rewrite of Ananicy in C++, featuring lower CPU and RAM usage'
arch=(x86_64)
url=https://gitlab.com/ananicy-cpp/ananicy-cpp
license=('GPL-3.0-or-later')
depends=(
  # glibc
  # libgcc
  # libelf
  # libstdc++
  libbpf
  fmt
  spdlog 
  pcre2
  zlib
)
makedepends=(
  bpf
  clang
  cmake
  lld
  llvm
  git
  ninja
  nlohmann-json
  # gcc15
)
source=(git+https://gitlab.com/ananicy-cpp/ananicy-cpp.git#tag=v${pkgver})
sha256sums=('21f07abc1e7aff9e90767e1a831920a74ee2be49d16099b1484c48081376dcc6')

prepare() {
  cd $pkgname

  sed -i '1s/^/#include <unistd.h>\n/' src/platform/linux/process.cpp
  sed -i '1s/^/#include <unistd.h>\n/' src/platform/linux/debug.cpp
  sed -i '1s/^/#include <cstdint>\n/' src/platform/linux/backtrace.cpp
  sed -i '1s/^/#include <cstring>\n/' src/platform/linux/singleton_process.cpp
  sed -i '1s/^/#include <cstring>\n/' src/utility/argument_parsing/argument.cpp
}

build() {
  # CC=gcc-15
  # CXX=g++-15
  # AR=gcc-ar-15
  # NM=gcc-nm-15
  # RANLIB=gcc-ranlib-15
  
  # export CC CXX NM AR RANLIB 
  
  # cmake -S $pkgname -B build -G Ninja \
  #       -DCMAKE_BUILD_TYPE=Release \
  #       -DCMAKE_INSTALL_PREFIX=/usr \
  #       -DCMAKE_SKIP_RPATH=ON \
  #       -DCMAKE_C_FLAGS="${CFLAGS}" \
  #       -DCMAKE_CXX_FLAGS="${CXXFLAGS}" \
  #       -DCMAKE_EXE_LINKER_FLAGS="${LDFLAGS}" \
  #       -DCMAKE_MODULE_LINKER_FLAGS="${LDFLAGS}" \
  #       -DCMAKE_SHARED_LINKER_FLAGS="${LDFLAGS}" \
  #       -DCMAKE_AR="/usr/bin/${AR}" \
  #       -DCMAKE_RANLIB="/usr/bin/${RANLIB}" \
  CC=clang
  CXX=clang++
  LD=ld.lld
  AR=llvm-ar
  NM=llvm-nm
  STRIP=llvm-strip
  OBJCOPY=llvm-objcopy
  OBJDUMP=llvm-objdump
  RANLIB=llvm-ranlib
  READELF=llvm-readelf

  export CC CXX LD AR NM STRIP OBJCOPY OBJDUMP RANLIB READELF

  LINKER="${LDFLAGS} -fuse-ld=lld"

  cmake -S $pkgname -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_SKIP_RPATH=ON \
    -DCMAKE_C_FLAGS="${CFLAGS} -fsplit-lto-unit" \
    -DCMAKE_CXX_FLAGS="${CXXFLAGS} -fsplit-lto-unit" \
    -DCMAKE_EXE_LINKER_FLAGS="${LINKER}" \
    -DCMAKE_MODULE_LINKER_FLAGS="${LINKER}" \
    -DCMAKE_SHARED_LINKER_FLAGS="${LINKER}" \
    -DCMAKE_AR="/usr/bin/${AR}" \
    -DCMAKE_RANLIB="/usr/bin/${RANLIB}" \
    -DVERSION=${pkgver} \
    -DUSE_EXTERNAL_SPDLOG=ON \
    -DUSE_EXTERNAL_JSON=ON \
    -DUSE_EXTERNAL_FMTLIB=ON \
    -DUSE_BPF_PROC_IMPL=ON \
    -DENABLE_REGEX_SUPPORT=ON \
    -DBPF_BUILD_LIBBPF=OFF \
    -DENABLE_SYSTEMD=OFF

  cmake --build build --target $pkgname
}

package() {
  DESTDIR="${pkgdir}" cmake --install build --component Runtime
  install -m755 -d "${pkgdir}/etc/ananicy.d"
  install -Dm644 "${pkgname}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
